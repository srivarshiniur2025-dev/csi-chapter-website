PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

MONGODB_URI=mongodb://127.0.0.1:27017/csi_platform

# Firebase Admin (required for protected API routes — verifies client Firebase ID tokens)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

ADMIN_EMAIL=admin@csi.vitc.edu
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=CSI Admin

# JWT for API auth (email/password login; works alongside Firebase tokens)
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
