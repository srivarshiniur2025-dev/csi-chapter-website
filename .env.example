# Firebase — required for production auth (email/password, Google, persistent sessions)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated emails that receive admin role in Firestore on first sign-in
VITE_ADMIN_EMAILS=admin@csi.vitc.edu

# Mongo API (optional — send Firebase ID tokens; see server/README.md)
VITE_API_URL=http://localhost:5000
